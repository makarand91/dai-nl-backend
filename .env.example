# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration
S3_BUCKET_NAME=newsletter-storage
S3_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_NEWSLETTER_TABLE=newsletters
DYNAMODB_HISTORY_TABLE=newsletter-history

# Email Provider Configuration
# Options: mailjet, ses, sendgrid, resend
EMAIL_PROVIDER=mailjet

# Mailjet Configuration (if using EMAIL_PROVIDER=mailjet)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_FROM_EMAIL=noreply@yourdomain.com
MAILJET_FROM_NAME=Newsletter System

# Amazon SES Configuration (if using EMAIL_PROVIDER=ses)
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REGION=us-east-1

# Cognito Configuration
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id
COGNITO_REGION=us-east-1

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl

# Strapi CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
